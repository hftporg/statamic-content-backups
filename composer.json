{
    "name": "hftp/statamic-content-backups",
    "description": "Nightly Statamic collection markdown backups to a private S3 bucket.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "league/flysystem-aws-s3-v3": "^3.25",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hftp\\StatamicContentBackups\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hftp\\StatamicContentBackups\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hftp\\StatamicContentBackups\\ContentBackupServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
